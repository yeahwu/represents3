# Required: one or more domains, comma separated.
PROXY_DOMAINS=proxy.example.com

# Optional but strongly recommended for production.
PROXY_USER=proxyuser
PROXY_PASS=change-me-strong-password

# Optional ACME settings.
ACME_EMAIL=admin@example.com
ACME_STAGING=true

# Runtime settings.
CERT_CACHE_DIR=./cert-cache
LISTEN_HTTP=:80
LISTEN_HTTPS=:443
UPSTREAM_DIAL_TIMEOUT=10s

# Logging: LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=text|json
LOG_LEVEL=info
LOG_FORMAT=text
LOG_SOURCE=false
